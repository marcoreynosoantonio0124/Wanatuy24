# ─────────────────────────────────────────────────────────────────────────────
# DueMate environment variables
# Copy to .env and fill in. Never commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---------------------------------------------------------------------
# App base URL, used to build deep links inside notification templates.
APP_URL="http://localhost:3000"

# Multi-tenant model, single-operator launch (spec A4). Leave false for v1.
PUBLIC_SIGNUP="false"

# Locale defaults (spec A11). Per-agreement values override these.
DEFAULT_TIMEZONE="Asia/Dubai"
DEFAULT_CURRENCY="AED"

# --- Database (PostgreSQL) ----------------------------------------------------
DATABASE_URL="postgresql://duemate:duemate@localhost:5432/duemate?schema=public"

# --- Auth.js ------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_URL="http://localhost:3000"

# --- Email (Resend or SMTP via Nodemailer) -----------------------------------
# Pick ONE transport. If RESEND_API_KEY is set, the Resend transport is used;
# otherwise the SMTP_* values are used. If neither is set, EmailChannel logs
# to stdout (dev mode) instead of sending.
EMAIL_FROM="DueMate <no-reply@example.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Deliverability: configure SPF + DKIM for EMAIL_FROM's domain. See README.

# --- SMS (stubbed in v1 — spec A2) -------------------------------------------
# SmsChannel is a logging stub. To enable later, add a Twilio adapter and set:
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
SMS_ENABLED="false"

# --- Object storage (S3-compatible) for proof uploads ------------------------
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="duemate-proofs"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Uploads are stored under proofs/{agreementId}/{occurrenceId}/{uuid} and
# served via signed URLs only. Never make the bucket public.

# --- Job queue (BullMQ + Redis) ----------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Maps (Leaflet + OpenStreetMap / Nominatim geocoding) --------------------
# Nominatim usage policy requires a contact string in the User-Agent.
NOMINATIM_USER_AGENT="DueMate/0.1 (you@example.com)"

# --- Data retention (spec §8) -------------------------------------------------
# Audit log retention for financial records, in years.
AUDIT_RETENTION_YEARS="7"
